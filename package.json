{
  "name": "edu-tug-of-war",
  "version": "1.0.0",
  "description": "Nigerian Schools Quiz Game + Language Academy — EdTek Interactive",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"node server.js\" \"vite\"",
    "server": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server.js",
    "test": "vitest run",
    "electron:dev": "concurrently \"node server.js\" \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win",
    "cap:android": "vite build && cap sync android && cap open android",
    "cap:ios": "vite build && cap sync ios && cap open ios",
    "cap:sync": "vite build && cap sync",
    "lint": "eslint src server.js electron tests --ext .js,.jsx,.cjs",
    "verify": "npm run lint && npm test && npm run build",
    "build:standalone": "node scripts/build-standalone.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/ios": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "lucide-react": "^0.383.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^24.1.3",
    "vite": "^5.0.0",
    "vitest": "^1.6.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.edtek.edutugofwar",
    "productName": "Edu Tug of War",
    "copyright": "EdTek Interactive",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": ".env.production",
        "to": ".env"
      }
    ]
  }
}
